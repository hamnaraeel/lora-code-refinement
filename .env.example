# Copy to .env and fill in what you have. Every one of these is optional:
# without them the pipeline logs locally and skips the LLM-as-judge stage
# rather than failing.

# --- experiment tracking ---------------------------------------------------
# With WANDB_API_KEY set, `tracker: auto` logs to Weights & Biases.
WANDB_API_KEY=
WANDB_PROJECT=lora-code-refinement

# Alternatively, MLflow (used when WANDB_API_KEY is absent).
# MLFLOW_TRACKING_URI=http://localhost:5000

# --- LLM-as-judge ----------------------------------------------------------
# Either provider works; anthropic is the default.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Hugging Face ----------------------------------------------------------
# Required only for gated base models such as Llama 3.
HF_TOKEN=

# --- runtime ---------------------------------------------------------------
TOKENIZERS_PARALLELISM=false
